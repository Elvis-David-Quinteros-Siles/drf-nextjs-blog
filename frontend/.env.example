# URL del backend vista desde el contenedor del frontend (red del compose)
API_URL=http://backend:8000
# Debe coincidir con uno de los VALID_API_KEYS del backend
BACKEND_API_KEY=cambiar-por-una-api-key
DOMAIN=http://localhost:3000

# ---- MinIO (subidas desde el navegador con URLs firmadas) ----
AWS_ACCESS_KEY_ID=blogminio
AWS_SECRET_ACCESS_KEY=cambiar-password-minio
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9020
NEXT_PUBLIC_AWS_S3_BUCKET_NAME=drf-nextjs-blog
