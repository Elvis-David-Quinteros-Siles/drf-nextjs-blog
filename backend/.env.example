# ---- Django ----
# En producción: DEBUG=False y USE_X_FORWARDED_PROTO=True (detrás de nginx con TLS)
DEBUG=True
USE_X_FORWARDED_PROTO=False
# Dominio del frontend para los enlaces de los correos (activación, reset de contraseña)
FRONTEND_DOMAIN=localhost:3000
FRONTEND_PROTOCOL=http
CHANNELS_ALLOWED_ORIGINS=http://localhost:3000
SECRET_KEY=cambiar-por-una-clave-secreta
# Debe coincidir con BACKEND_API_KEY del frontend
VALID_API_KEYS=cambiar-por-una-api-key
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ORIGIN_WHITELIST=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8020

# ---- PostgreSQL (contenedor externo "postgres", publicado en el host:5432) ----
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_NAME=drf_nextjs_blog
DATABASE_USER=postgres
DATABASE_PASSWORD=cambiar-password-postgres

# ---- Redis (servicio del compose) ----
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0

# ---- MinIO (contenedor externo "blog-minio", red "blog-minio-net") ----
# Credenciales de MinIO (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD o un access key creado en MinIO)
AWS_ACCESS_KEY_ID=blogminio
AWS_SECRET_ACCESS_KEY=cambiar-password-minio
AWS_STORAGE_BUCKET_NAME=drf-nextjs-blog
AWS_S3_REGION_NAME=us-east-1
# Dirección interna (desde los contenedores)
AWS_S3_ENDPOINT_URL=http://blog-minio:9000
# Dirección pública (desde el navegador), va dentro de las URLs firmadas
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9020
AWS_QUERYSTRING_EXPIRE=3600

# ---- Correo (opcional) ----
# Sin EMAIL_HOST los correos se imprimen en los logs del backend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Blog <no-reply@example.com>
# CONTACT_EMAIL=contacto@example.com

# ---- Login con Google y GitHub (opcional) ----
# Callback autorizado en cada proveedor:
#   https://<FRONTEND_DOMAIN>/api/auth/oauth/google-oauth2/callback
#   https://<FRONTEND_DOMAIN>/api/auth/oauth/github/callback
# GOOGLE_OAUTH2_CLIENT_ID=
# GOOGLE_OAUTH2_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
